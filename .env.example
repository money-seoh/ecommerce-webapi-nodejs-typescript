# Database connection string used by Prisma (SQL Server)
# Format: sqlserver://<host>:<port>;database=<db>;user=<user>;PLACEHOLDER_CREDENTIAL;trustServerCertificate=true
# Supply your own local/dev credential value for PLACEHOLDER_CREDENTIAL; never commit real secrets.
DATABASE_URL="sqlserver://localhost:1433;database=ecommerce;user=sa;PLACEHOLDER_CREDENTIAL;trustServerCertificate=true"

# HTTP server port
PORT=3000

# Bcrypt salt rounds used for password hashing
BCRYPT_SALT_ROUNDS=10
